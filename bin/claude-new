#!/usr/bin/env bash
set -euo pipefail
if [ $# -lt 1 ]; then
  echo "usage: claude-new <dir> [\"one-line project description\"]" >&2
  exit 1
fi
dir="$1"; shift
desc="${*:-}"
mkdir -p "$dir"
cd "$dir"
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git init -q
  git commit -q --allow-empty -m "chore: init"
fi
exec claude "/spidey:kickoff $desc"
