{
  "enabledPlugins": {
    "spidey@spidey-kit": true,
    "bmad-method@bmad": true
  },
  "extraKnownMarketplaces": {
    "bmad": {
      "source": { "source": "github", "repo": "bmad-code-org/bmad-plugins" }
    }
  },
  "permissions": {
    "allow": [
      "Bash(scripts/check)",
      "Bash(./scripts/check)",
      "Bash(scripts/fmt *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(npx playwright *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  }
}
